{
  "expo": {
    "name": "뽀시래기",
    "slug": "pawmate",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pawmate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "반려동물 프로필 사진 촬영에 사용됩니다.",
        "NSPhotoLibraryUsageDescription": "반려동물 프로필 사진 선택에 사용됩니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF5EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tgnugul.pawmate"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F5A623",
          "defaultChannel": "care-reminders"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "반려동물 사진을 갤러리에서 선택하는 데 사용됩니다.",
          "savePhotosPermission": "반려동물 사진을 갤러리에 저장하는 데 사용됩니다.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CareWidget",
              "label": "뽀시래기 케어",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "오늘의 반려동물 케어 일정",
              "previewImage": "./assets/images/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "both"
            },
            {
              "name": "WalkWidget",
              "label": "뽀시래기 산책",
              "minWidth": "110dp",
              "minHeight": "73dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "산책 시작 및 현황",
              "previewImage": "./assets/images/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "both"
            }
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "산책 경로 기록을 위해 위치 정보가 사용됩니다.",
          "locationAlwaysAndWhenInUsePermission": "산책 중 화면을 끄거나 다른 앱을 사용해도 경로를 계속 기록하기 위해 위치 정보가 사용됩니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb44e700-07ec-451a-9bb0-544e2c600bc2"
      }
    }
  }
}
